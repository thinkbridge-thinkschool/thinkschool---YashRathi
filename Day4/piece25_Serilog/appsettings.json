{
  "Jwt": {
    "Key": "super-secret-jwt-signing-key-must-be-32-bytes-min!!",
    "Issuer": "QuotesApi",
    "Audience": "QuotesApiUsers",
    "ExpiresInSeconds": 900
  },
  "EntraId": {
    "TenantId": "YOUR_TENANT_ID",
    "ClientId": "YOUR_CLIENT_ID",
    "Audience": "api://YOUR_CLIENT_ID",
    "Instance": "https://login.microsoftonline.com/"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=quotes.db"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{TraceId}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*"
}
