{
  "Jwt": {
    "Issuer": "QuotesApi",
    "Audience": "QuotesApiUsers",
    "AccessTokenLifetime": "00:15:00"
  },
  "EntraId": {
    "TenantId": "YOUR_TENANT_ID",
    "ClientId": "YOUR_CLIENT_ID",
    "Audience": "api://YOUR_CLIENT_ID",
    "Instance": "https://login.microsoftonline.com/"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=Day20OutboxDb;Trusted_Connection=True;TrustServerCertificate=True",
    "Redis": ""
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{TraceId}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "http://localhost:4317"
  },
  "AzureKeyVault": {
    "Uri": ""
  },
  "ApplicationInsights": {
    "ConnectionString": ""
  },
  "AllowedHosts": "*"
}
